<Page x:Class="SomwApp.ui.Frames.ReviewFilesViewOnlyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SomwApp.ui.Frames"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:rules="clr-namespace:SomwApp.presentation.rules"
      xmlns:converters="clr-namespace:SomwApp.presentation.converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReviewFilesViewOnlyPage" Background="White" DataContext="{Binding RelativeSource={RelativeSource Self}, Path=viewModel}">
    <Page.Resources>
        <converters:DateOnlyConverter x:Key="DateTimeToDateConverter"/>
        <converters:ReviewTypeConverter x:Key="ReviewTypeConverter"/>
        <converters:ReviewTypesConverter x:Key="ReviewTypesConverter"/>
    </Page.Resources>
    <Grid Margin="4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu Grid.ColumnSpan="2" HorizontalAlignment="Stretch">
            <MenuItem Header="Управление отчётами">
                <MenuItem Header="Удалить отчёты" Icon="{materialDesign:PackIcon Kind=Delete}" Command="{Binding ReviewsDeleteCommand}" CommandParameter="{Binding ReviewsToOperate}"/>
                <MenuItem Header="Скачать отчёты" Icon="{materialDesign:PackIcon Kind=Download}" Command="{Binding ReviewsDownloadCommand}" CommandParameter="{Binding ReviewsToOperate}"/>
                <MenuItem Header="Отменить скачивание" Icon="{materialDesign:PackIcon Kind=Stop}" Command="{Binding ReviewsCancelDownloadCommand}" CommandParameter="{Binding ElementName=DownloadQueueDGr, Path=SelectedItem}"/>
            </MenuItem>
        </Menu>
        <TabControl Grid.Row="1">
            <TabItem Header="Отчёты">
                <DataGrid Name="ReviewsDgr" ItemsSource="{Binding ReviewFiles}" SelectionMode="Extended"  Grid.Row="1" CanUserAddRows="False"  AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="OnReviewsSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название отчёта" Binding="{Binding ReviewName}"/>
                        <DataGridTextColumn Header="Тип отчёта" Binding="{Binding ReviewType, Converter={StaticResource ReviewTypeConverter}}"/>
                        <DataGridTextColumn Header="Дата создания" Binding="{Binding ReviewDate, ConverterCulture=ru}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Очередь загрузки">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Grid.ColumnSpan="2" Padding="8" Text="Прогресс загрузки файла" HorizontalAlignment="Stretch" FontSize="20" FontFamily="Sans" FontWeight="Bold"/>
                        <ProgressBar Name="DownloadProgress" Height="16" Margin="8,12"/>
                    </StackPanel>
                    <DataGrid Name="DownloadQueueDGr" ItemsSource="{Binding DownloadQueue}" HeadersVisibility="None" SelectionMode="Single" Grid.Row="1" CanUserAddRows="False"  AutoGenerateColumns="False" IsReadOnly="True" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название отчёта" Binding="{Binding ReviewName}"/>
                            <DataGridTextColumn Header="Тип отчёта" Binding="{Binding ReviewType, Converter={StaticResource ReviewTypeConverter}}"/>
                            <DataGridTextColumn Header="Дата создания" Binding="{Binding ReviewDate, ConverterCulture=ru}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
