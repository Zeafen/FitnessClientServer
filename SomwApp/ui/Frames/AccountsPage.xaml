<Page x:Class="SomwApp.ui.Frames.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SomwApp.ui.Frames"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:rules="clr-namespace:SomwApp.presentation.rules"
      xmlns:converters="clr-namespace:SomwApp.presentation.converters"    
      xmlns:presentation="clr-namespace:SomwApp.presentation"    
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountsPage" Background="White" DataContext="{Binding RelativeSource={RelativeSource Self}, Path=viewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Padding="8" Text="Роль" HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,4" FontSize="14" FontFamily="Sans"/>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" Margin="8,0" ItemsSource="{Binding Roles}" SelectedItem="{Binding RoleFilter}" DisplayMemberPath="RoleName"/>
            <Button Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="9,4" Background="Transparent" Command="{Binding ClearFiltersCommand}">
                <Button.Content>
                    <materialDesign:PackIcon Kind="CancelBold" />
                </Button.Content>
            </Button>
            
        </Grid>

        <DataGrid Grid.Row="1" Name="AccountsDGr" ItemsSource="{Binding UserAccounts}" SelectionChanged="OnUserAccountsSelectionChanged" SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID_UserAccounts}"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.RoleName}"/>
            </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Grid.Column="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Hidden" >
            <Grid Name="InfoField" DataContext="{Binding SelectedAccount}" >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" Padding="8" Text="Данные об учётной записи" TextWrapping="WrapWithOverflow" TextAlignment="Center" HorizontalAlignment="Center" FontSize="20" FontFamily="Sans" FontWeight="Bold"/>

                <TextBlock Grid.Row="1" Text="Логин:" FontSize="16" FontFamily="Sans" Padding="8" TextAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.Row="1" Margin="8,0" FontSize="10" FontFamily="Sans" VerticalAlignment="Center">
                    <TextBox.Text>
                        <Binding Path="Login" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <rules:NotEmptyStringRule/>
                                <rules:LettersLimitRule Min="8" Max="20"/>
                                <rules:OnlyLettersRule />
                                <ExceptionValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <TextBlock Grid.Row="2"  Text="Пароль:" FontSize="16" FontFamily="Sans" Padding="8" TextAlignment="Center" VerticalAlignment="Center"/>
                <PasswordBox Grid.Column="1" PasswordChar="#" Name="Password_Input" Grid.Row="2" VerticalAlignment="Center" Margin="8,0" ToolTip="Enter your login"
                 presentation:PasswordHelper.Attach="True" presentation:PasswordHelper.Password="{Binding Password, Mode=TwoWay}" MaxLength="29"/>

                <TextBlock Grid.Row="3" Text="Роль:" FontSize="16" FontFamily="Sans" Padding="8" TextAlignment="Center" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Grid.Row="3" Margin="12" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.Roles}" SelectedItem="{Binding Role}" DisplayMemberPath="RoleName"/>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                    <Button Content="Изменить данные об учётной записи" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.AccountEditCommand}" CommandParameter="{Binding ElementName=InfoField, Path=DataContext}"/>
                    <Button Content="Удалить данные об учётной записи" Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8" Click="Button_Click"/>
                    <Button Content="Добавить данные об учётной записи" Grid.Row="5" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.AccountAddCommand}" CommandParameter="{Binding ElementName=InfoField, Path=DataContext}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
