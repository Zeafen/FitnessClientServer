<Page x:Class="SomwApp.ui.Frames.AppointmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SomwApp.ui.Frames"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:rules="clr-namespace:SomwApp.presentation.rules"
      xmlns:converters="clr-namespace:SomwApp.presentation.converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppointmentsPage" Background="White" DataContext="{Binding RelativeSource={RelativeSource Self}, Path=viewModel}">
    <Page.Resources>
        <converters:DateOnlyConverter x:Key="DateTimeToDateConverter"/>
    </Page.Resources>
    <Grid Margin="4,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DataGrid Name="AppointmentsDgr" ItemsSource="{Binding Appointments}"  Grid.Row="1" CanUserAddRows="False"  AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="AppointmentsDgr_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID_AppointmentsForClasses}"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Customer.FullName}"/>
                <DataGridTextColumn Header="Занятие" Binding="{Binding Lesson.Title}"/>
                <DataGridTextColumn Header="Дата занятия" Binding="{Binding Lesson.Date, ConverterCulture=ru}"/>
                <DataGridTextColumn Header="Время занятия" Binding="{Binding Lesson.Time, ConverterCulture=ru}"/>
                <DataGridTextColumn Header="Дата записи" Binding="{Binding Date_recording, ConverterCulture=ru}"/>
                <DataGridTextColumn Header="Статус посещения" Binding="{Binding Status_recording}"/>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter BorderThickness="1.5" BorderBrush="Black" ResizeDirection="Columns"/>
        <TabControl Grid.Row="1" Grid.Column="1">
            <TabItem Header="Данные">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" VerticalAlignment="Bottom" >
                    <Grid Name="InfoField" DataContext="{Binding SelectedAppointment}" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Padding="8" Text="Данные о посещении" HorizontalAlignment="Center" FontSize="20" FontFamily="Sans" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Text="Клиент" TextWrapping="Wrap" FontSize="14" FontFamily="Sans" Padding="8" TextAlignment="Center" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Grid.Row="1" Margin="12" FontSize="10" FontFamily="Sans" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="FullName"/>

                        <TextBlock Grid.Row="2" Text="Занятие" TextWrapping="Wrap" FontSize="14" FontFamily="Sans" Padding="8" TextAlignment="Center" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" Grid.Row="2" Margin="12" FontSize="10" FontFamily="Sans" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.Lessons}" SelectedItem="{Binding Lesson}" DisplayMemberPath="FullName"/>
                        
                        
                        <TextBlock Grid.Row="3" Text="Дата:" FontSize="14" FontFamily="Sans" Padding="8" TextAlignment="Center" VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="1" Grid.Row="3" Margin="8,0" SelectedDate="{Binding Date_recording, Converter={StaticResource DateTimeToDateConverter}, ConverterCulture=ru}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="4" Text="Статус посещения" TextWrapping="Wrap" FontSize="14" FontFamily="Sans" Padding="8" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" FontSize="10" FontFamily="Sans" Margin="8" VerticalAlignment="Center" TextWrapping="NoWrap" TextAlignment="Center">
                            <TextBox.Text>
                                <Binding Path="Status_recording" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <ExceptionValidationRule/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                            <Button Content="Изменить данные об оплате" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.AppointmentEditCommand}" CommandParameter="{Binding ElementName=InfoField, Path=DataContext}"/>
                            <Button Content="Удалить данные об оплате" Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8" Click="Button_Click"/>
                            <Button Content="Добавить данные об оплате" Grid.Row="5" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.AppointmentAddCommand}" CommandParameter="{Binding ElementName=InfoField, Path=DataContext}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Фильтрация">
                <StackPanel Orientation="Vertical">
                    <TextBlock Grid.ColumnSpan="2" Padding="8" Text="Атрибуты фильтрации" HorizontalAlignment="Center" FontSize="18" FontFamily="Sans" FontWeight="Bold"/>
                    <Separator Margin="0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Padding="8,4" Text="По клиенту" TextAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                        <ComboBox Grid.Column="1" Margin="9,0" ToolTip="Выберите тренера" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding Customers}" SelectedItem="{Binding CustomerFilter}" DisplayMemberPath="FullName"/>
                    </Grid>
                    <Separator Margin="0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Padding="8,4" Text="По занятию" TextAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                        <ComboBox Grid.Column="1" Margin="9,0" ToolTip="Выберите тренера" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding Lessons}" SelectedItem="{Binding LessonFilter}" DisplayMemberPath="Title"/>
                    </Grid>
                    <Separator Margin="0,12"/>

                    <TextBlock Padding="0,4" Text="По дате" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock  Padding="0,4" Text="Дата с" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                        <DatePicker Grid.Column="1" Margin="8,4" VerticalAlignment="Center" SelectedDate="{Binding DateFromFilter, ConverterCulture=ru, Converter={StaticResource DateTimeToDateConverter}}"/>
                        <TextBlock Grid.Row="1" Padding="0,4" Text="Дата по" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                        <DatePicker Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="8,4" SelectedDate="{Binding DateToFilter, ConverterCulture=ru, Converter={StaticResource DateTimeToDateConverter}}"/>
                    </Grid>
                    <Separator Margin="0,12"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
