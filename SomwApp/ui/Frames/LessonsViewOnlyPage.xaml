<Page x:Class="SomwApp.ui.Frames.LessonsViewOnlyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SomwApp.ui.Frames"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:rules="clr-namespace:SomwApp.presentation.rules"
      xmlns:converters="clr-namespace:SomwApp.presentation.converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LessonsPage" Background="White" DataContext="{Binding RelativeSource={RelativeSource Self}, Path=viewModel}">
    <Page.Resources>
        <converters:DateOnlyConverter x:Key="DateTimeToDateConverter"/>
        <converters:TimeOnlyConverter x:Key="DateTimeToTimeConverter"/>
    </Page.Resources>

    <Grid Margin="4,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <DataGrid Name="LessonsDGr" ItemsSource="{Binding Lessons}"  Grid.Row="1" CanUserAddRows="False"  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID_Lessons}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, ConverterCulture=ru}"/>
                <DataGridTextColumn Header="Время" Binding="{Binding Time, ConverterCulture=ru}"/>
                <DataGridTextColumn Header="Количество практикантов" Binding="{Binding NumberOfPracticants}"/>
                <DataGridTextColumn Header="Тренер" Binding="{Binding Coach.FullName}"/>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter BorderThickness="1.5" BorderBrush="Black" ResizeDirection="Columns"/>
        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1">
            <TextBlock Grid.ColumnSpan="2" Padding="8" Text="Атрибуты фильтрации" HorizontalAlignment="Center" FontSize="18" FontFamily="Sans" FontWeight="Bold"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
            </Grid>
            <Separator Margin="0,12"/>
            <TextBlock Padding="0,4" Text="По дате" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock  Padding="0,4" Text="Дата с" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                <DatePicker Grid.Column="1" Margin="8,4" VerticalAlignment="Center" SelectedDate="{Binding DateFromFilter, ConverterCulture=ru, Converter={StaticResource DateTimeToDateConverter}}"/>
                <TextBlock Grid.Row="1" Padding="0,4" Text="Дата по" TextAlignment="Center" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                <DatePicker Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="8,4" SelectedDate="{Binding DateToFilter, ConverterCulture=ru, Converter={StaticResource DateTimeToDateConverter}}"/>
            </Grid>
            <Separator Margin="0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Padding="8,4" Text="По назначенному времени" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="14" FontFamily="Sans" />
                <materialDesign:TimePicker Grid.Column="1" Margin="8,4" ToolTip="Выберите время" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectedTime="{Binding TimeFilter, Converter={StaticResource DateTimeToTimeConverter}, ConverterCulture=ru}"/>
            </Grid>
            <Button Content="Изменить данные об оплате" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="8" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Page}}, Path=DataContext.ClearFiltersCommand}"/>

        </StackPanel>
    </Grid>
</Page>
